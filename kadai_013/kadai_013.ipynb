      "source": [
        "# 与えられた引数priceに消費税を加算し、その値を出力する関数を定義する\n",
        "def calculate_total_with_tax(price):\n",
        "    cons_tax = 0.1 # 消費税を定数として定義\n",
        "    total = price + cons_tax * price\n",
        "    print(f\"{total}円\")\n",
        "\n",
        "# 関数を呼び出し、引数として価格を渡す\n",
        "calculate_total_with_tax(110) # 例として110円を渡す"
      ]
