        "# 与えられた引数priceに消費税を加算し、その値を出力する関数を定義する\n",
        "def calculate_total_with_tax(price,tax):\n",
        "    total = price + tax * price / 100\n",
        "    print(f\"{total}円\")\n",
        "\n",
        "# 関数を呼び出し、引数として価格を渡す\n",
        "calculate_total_with_tax(110, 10) # 例として110円, 10%を渡す"
      ]
